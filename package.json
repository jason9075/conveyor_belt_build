{
  "name": "conveyor-belt-build",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --require ./scripts/fix-noexec.cjs ./node_modules/vite/bin/vite.js --port 8080",
    "build": "node --require ./scripts/fix-noexec.cjs ./node_modules/vite/bin/vite.js build",
    "preview": "node --require ./scripts/fix-noexec.cjs ./node_modules/vite/bin/vite.js preview --port 8080",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "vite": "^5.4.0"
  }
}
